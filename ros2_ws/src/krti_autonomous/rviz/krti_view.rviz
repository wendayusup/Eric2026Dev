Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: local_origin
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Show Axes: true
      Show Arrows: true
      Show Names: true
      Update Interval: 0
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: local_origin
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/InteractTool
    - Class: rviz_default_plugins/MoveCameraTool
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 10
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.78
      Yaw: 0.78
